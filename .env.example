# Kopyasını '.env' olarak kaydet ('.env*' gitignore'da, repo'ya basılmaz).
# Token: Telegram'da @BotFather'a gidip /newbot -> bot adı -> kullanıcı adı, verilen token'ı yapıştır.
TELEGRAM_TOKEN=
# Chat ID: botuna önce /start yaz, sonra: python get_chat_id.py
TELEGRAM_CHAT_ID=
# Mesajlara panel bağlantısı ekler (opsiyonel).
DASHBOARD_URL=http://127.0.0.1:8000
# Polis mok webhook'u (opsiyonel, varsayılan yerel).
POLICE_WEBHOOK_URL=http://127.0.0.1:8000/mock/police